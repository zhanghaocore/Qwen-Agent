{
    // 选择 Python 解释器
    "python.pythonPath": "/usr/bin/python3", // 请将此路径替换为您的实际 Python 解释器路径

    // 设置代码格式化工具为 Black
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "python.formatting.blackArgs": [
        "--line-length",
        "88"
    ],

    // 启用并配置代码检查工具 PyLint
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.lintOnSave": true,

    // 启用并配置类型检查工具 MyPy
    "python.linting.mypyEnabled": true,
    "python.linting.mypyArgs": [
        "--ignore-missing-imports"
    ],

    // 其他有用的编辑器设置
    "editor.tabSize": 4, // 设置缩进为4个空格
    "editor.insertSpaces": true, // 使用空格代替制表符
    "files.autoSave": "onFocusChange", // 当编辑器失去焦点时自动保存
    "editor.rulers": [88], // 在第88列显示垂直参考线
    "editor.wordWrap": "on", // 启用自动换行
    "editor.minimap.enabled": false // 禁用代码小地图
}
