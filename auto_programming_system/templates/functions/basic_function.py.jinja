"""
{{ function_description }}
"""
{% if imports %}
{% for import_statement in imports %}
{{ import_statement }}
{% endfor %}
{% endif %}

def {{ function_name }}({% for param in parameters %}{{ param.name }}{% if param.type %}: {{ param.type }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}){% if return_type %} -> {{ return_type }}{% endif %}:
    """
    {{ function_description }}
    
    {% if parameters %}
    Args:
        {% for param in parameters %}
        {{ param.name }}: {{ param.description }}
        {% endfor %}
    {% endif %}
    
    {% if return_description %}
    Returns:
        {{ return_description }}
    {% endif %}
    
    {% if examples %}
    Examples:
        {% for example in examples %}
        >>> {{ function_name }}({{ example.input }})
        {{ example.output }}
        {% endfor %}
    {% endif %}
    """
    {% if implementation %}
    {{ implementation }}
    {% else %}
    # 实现函数逻辑
    {% if 'list' in function_description and 'sum' in function_description %}
    result = 0
    for item in {{ parameters[0].name }}:
        {% if 'even' in function_description or '偶数' in function_description %}
        if item % 2 == 0:
            result += item
        {% elif 'odd' in function_description or '奇数' in function_description %}
        if item % 2 != 0:
            result += item
        {% else %}
        result += item
        {% endif %}
    return result
    {% elif 'list' in function_description and 'filter' in function_description %}
    result = []
    for item in {{ parameters[0].name }}:
        {% if 'even' in function_description or '偶数' in function_description %}
        if item % 2 == 0:
            result.append(item)
        {% elif 'odd' in function_description or '奇数' in function_description %}
        if item % 2 != 0:
            result.append(item)
        {% elif 'positive' in function_description or '正数' in function_description %}
        if item > 0:
            result.append(item)
        {% elif 'negative' in function_description or '负数' in function_description %}
        if item < 0:
            result.append(item)
        {% endif %}
    return result
    {% elif 'sort' in function_description %}
    return sorted({{ parameters[0].name }})
    {% elif 'convert' in function_description and ('celsius' in function_description or '摄氏' in function_description) and ('fahrenheit' in function_description or '华氏' in function_description) %}
    return {{ parameters[0].name }} * 9/5 + 32
    {% elif 'convert' in function_description and ('fahrenheit' in function_description or '华氏' in function_description) and ('celsius' in function_description or '摄氏' in function_description) %}
    return ({{ parameters[0].name }} - 32) * 5/9
    {% else %}
    # 通用实现
    pass
    {% endif %}
    {% endif %}
